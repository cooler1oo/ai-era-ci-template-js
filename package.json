{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "从这里开始写你的项目",
  "scripts": {
    "test": "vitest run",
    "test:fast": "vitest run --exclude '**/*.slow.test.*'",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "vitest": "^2.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,vue,svelte}": [
      "prettier --write"
    ],
    "*.{json,md,css,scss,yml,yaml}": [
      "prettier --write"
    ]
  }
}
